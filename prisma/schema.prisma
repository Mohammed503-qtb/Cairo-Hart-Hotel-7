// Cairo Heart Hotel — Prisma schema (Supabase Postgres)
// All entities from PLAN.md section 51

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ────────────────────────────────────────────────────────────
// AUTH & USERS
// ────────────────────────────────────────────────────────────

model User {
  id              String   @id @default(cuid())
  email           String?  @unique
  phone           String?
  name            String
  passwordHash    String?
  status          String   @default("active") // active | disabled
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  roles           UserRole[]
  auditLogs       AuditLog[]
  reservations    Reservation[]    @relation("ReservationCreatedBy")
  payments        Payment[]         @relation("PaymentRecordedBy")
  serviceRequests ServiceRequest[]  @relation("ServiceRequestAssignedTo")
  bookingRequests BookingRequest[]  @relation("BookingRequestOwner")
  contactRequests  ContactRequest[] @relation("ContactRequestOwner")
  reviews         Review[]          @relation("ReviewApprovedBy")

  @@map("users")
}

model Role {
  id          String   @id @default(cuid())
  key         String   @unique // admin | manager | receptionist | booking_operator | housekeeping | content_editor
  nameAr      String
  nameEn      String
  description String?
  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id    String @id @default(cuid())
  key   String @unique // reservation.view, payment.record, content.publish, ...
  label String
  roles RolePermission[]

  @@map("permissions")
}

model UserRole {
  id      String @id @default(cuid())
  userId  String
  roleId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role    Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  id           String @id @default(cuid())
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

// ────────────────────────────────────────────────────────────
// GUESTS
// ────────────────────────────────────────────────────────────

model Guest {
  id        String   @id @default(cuid())
  name      String
  phone     String
  whatsapp  String?
  email     String?
  notes     String?
  blacklisted Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookingRequests BookingRequest[]
  reservations    Reservation[]
  serviceRequests ServiceRequest[]
  reviews         Review[]
  contactRequests ContactRequest[]

  @@map("guests")
}

// ────────────────────────────────────────────────────────────
// ROOMS
// ────────────────────────────────────────────────────────────

model RoomType {
  id           String  @id @default(cuid())
  slug         String  @unique
  nameAr       String
  nameEn       String
  descriptionAr String
  descriptionEn String
  basePrice    Decimal @db.Decimal(12, 2)
  currency     String  @default("YER")
  capacity     Int     @default(2)
  beds          String  // "1 King" / "2 Single"
  size         Float?  // sqm
  amenitiesJson String // JSON array of amenity keys
  imageUrl     String?  // main image URL
  status       String  @default("published") // draft | published | hidden | archived
  sortOrder    Int     @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  rooms        Room[]
  rates        RoomRate[]
  reservations Reservation[]
  offerRooms   OfferRoom[]
  media        RoomTypeMedia[]
  bookingRequests BookingRequest[]

  @@map("room_types")
}

model RoomTypeMedia {
  id          String   @id @default(cuid())
  roomTypeId  String
  url         String
  altAr       String?
  altEn       String?
  captionAr   String?
  captionEn   String?
  sortOrder   Int      @default(0)
  published   Boolean  @default(true)
  roomType    RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)

  @@map("room_type_media")
}

model Room {
  id          String   @id @default(cuid())
  number      String   @unique
  roomTypeId   String
  floor       Int?
  status      String   @default("available") // available | reserved | occupied | cleaning | maintenance | blocked | out_of_service
  notes       String?
  lastCleanedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roomType      RoomType      @relation(fields: [roomTypeId], references: [id])
  reservations  Reservation[]
  serviceRequests ServiceRequest[]
  housekeepingTasks HousekeepingTask[]

  @@map("rooms")
}

model RoomRate {
  id         String  @id @default(cuid())
  roomTypeId String
  date       DateTime @db.Date
  price      Decimal @db.Decimal(12, 2)
  currency   String  @default("YER")
  closed     Boolean @default(false)
  roomType   RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)

  @@unique([roomTypeId, date])
  @@map("room_rates")
}

// ────────────────────────────────────────────────────────────
// BOOKING REQUESTS & RESERVATIONS
// ────────────────────────────────────────────────────────────

model BookingRequest {
  id           String   @id @default(cuid())
  reference    String   @unique
  guestId      String
  roomTypeId   String?
  checkIn      DateTime @db.Date
  checkOut     DateTime @db.Date
  adults       Int      @default(1)
  children     Int      @default(0)
  nights       Int
  guestName    String
  guestPhone   String
  guestWhatsapp String?
  message      String?
  status       String   @default("new") // new | assigned | contacted | waiting_customer | waiting_hotel | confirmed | converted | closed | cancelled
  priority     String   @default("normal") // low | normal | high | urgent
  ownerId      String?  // staff owner
  channel      String   @default("app") // app | website | whatsapp | reception | phone | admin
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  guest       Guest        @relation(fields: [guestId], references: [id])
  roomType    RoomType?   @relation(fields: [roomTypeId], references: [id])
  owner       User?        @relation("BookingRequestOwner", fields: [ownerId], references: [id])
  contactRequests ContactRequest[]
  reservation Reservation?

  @@index([status])
  @@index([checkIn])
  @@map("booking_requests")
}

model Reservation {
  id              String   @id @default(cuid())
  confirmationNo  String   @unique
  guestId         String
  roomTypeId      String
  roomId          String?
  checkIn         DateTime @db.Date
  checkOut        DateTime @db.Date
  adults          Int      @default(1)
  children        Int      @default(0)
  nights          Int
  roomPriceSnapshot Decimal @db.Decimal(12, 2)
  discountSnapshot Decimal @db.Decimal(12, 2) @default(0)
  servicesSnapshot Decimal @db.Decimal(12, 2) @default(0)
  feesSnapshot    Decimal  @db.Decimal(12, 2) @default(0)
  totalSnapshot   Decimal  @db.Decimal(12, 2)
  currency        String   @default("YER")
  paidAmount      Decimal  @db.Decimal(12, 2) @default(0)
  remainingAmount Decimal  @db.Decimal(12, 2)
  paymentStatus   String   @default("pending") // pending | submitted | under_review | paid | partially_paid | failed | cancelled | refunded | partially_refunded
  bookingStatus   String   @default("pending") // draft | pending | awaiting_confirmation | confirmed | checked_in | checked_out | completed | cancelled | no_show | rejected
  cancellationStatus String?
  source          String   @default("app") // app | website | whatsapp | reception | phone | admin | walk_in
  createdById     String
  createdReason   String?
  bookingRequestId String? @unique
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  guest          Guest          @relation(fields: [guestId], references: [id])
  roomType        RoomType       @relation(fields: [roomTypeId], references: [id])
  room           Room?          @relation(fields: [roomId], references: [id])
  createdBy      User           @relation("ReservationCreatedBy", fields: [createdById], references: [id])
  bookingRequest BookingRequest? @relation(fields: [bookingRequestId], references: [id])
  payments       Payment[]
  serviceRequests ServiceRequest[]
  reviews        Review[]
  contactRequests ContactRequest[]
  invoice        Invoice?

  @@index([bookingStatus])
  @@index([checkIn])
  @@index([roomId])
  @@map("reservations")
}

// ────────────────────────────────────────────────────────────
// SERVICES & SERVICE REQUESTS
// ────────────────────────────────────────────────────────────

model Service {
  id           String  @id @default(cuid())
  slug         String  @unique
  nameAr       String
  nameEn       String
  descriptionAr String?
  descriptionEn String?
  price        Decimal @db.Decimal(12, 2) @default(0)
  currency     String  @default("YER")
  category     String  @default("general") // cleaning | food | maintenance | transport | laundry | other
  imageUrl     String?
  status       String  @default("published") // draft | published | hidden | archived
  sortOrder    Int     @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  serviceRequests ServiceRequest[]

  @@map("services")
}

model ServiceRequest {
  id          String   @id @default(cuid())
  reference   String   @unique
  guestId     String?
  reservationId String?
  roomId      String?
  serviceId   String?
  category    String  @default("general")
  descriptionAr String
  priority    String   @default("normal") // low | normal | high | urgent
  status       String   @default("new") // new | accepted | assigned | in_progress | waiting | completed | cancelled | rejected
  assignedToId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  completedAt DateTime?

  guest       Guest?     @relation(fields: [guestId], references: [id])
  reservation Reservation? @relation(fields: [reservationId], references: [id])
  room        Room?      @relation(fields: [roomId], references: [id])
  service     Service?   @relation(fields: [serviceId], references: [id])
  assignedTo  User?      @relation("ServiceRequestAssignedTo", fields: [assignedToId], references: [id])

  @@index([status])
  @@map("service_requests")
}

model HousekeepingTask {
  id        String   @id @default(cuid())
  roomId    String
  status    String   @default("pending") // pending | in_progress | done
  priority  String   @default("normal")
  notes     String?
  assignedToId String?
  createdAt DateTime @default(now())
  completedAt DateTime?

  room      Room      @relation(fields: [roomId], references: [id])

  @@map("housekeeping_tasks")
}

// ────────────────────────────────────────────────────────────
// PAYMENTS & INVOICES
// ────────────────────────────────────────────────────────────

model Payment {
  id          String   @id @default(cuid())
  reference   String   @unique
  reservationId String
  method      String   // cash | bank_transfer | local | online | manual
  amount      Decimal  @db.Decimal(12, 2)
  currency    String   @default("YER")
  status      String   @default("pending") // pending | submitted | under_review | paid | failed | cancelled | refunded | partially_refunded
  externalRef String?
  proofUrl    String?
  notes       String?
  recordedById String
  reviewedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  reservation Reservation @relation(fields: [reservationId], references: [id])
  recordedBy  User        @relation("PaymentRecordedBy", fields: [recordedById], references: [id])

  @@index([reservationId])
  @@map("payments")
}

model Invoice {
  id           String   @id @default(cuid())
  number       String   @unique
  reservationId String   @unique
  issuedAt     DateTime @default(now())
  dueAt        DateTime?

  reservation  Reservation @relation(fields: [reservationId], references: [id])

  @@map("invoices")
}

// ────────────────────────────────────────────────────────────
// OFFERS
// ────────────────────────────────────────────────────────────

model Offer {
  id          String   @id @default(cuid())
  slug        String   @unique
  nameAr      String
  nameEn      String
  descriptionAr String
  descriptionEn String
  imageUrl    String?
  startsAt    DateTime
  endsAt      DateTime
  discountType String  @default("percentage") // percentage | fixed
  discountValue Decimal @db.Decimal(12, 2)
  conditions  String?
  status      String   @default("draft") // draft | published | hidden | archived
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rooms       OfferRoom[]

  @@map("offers")
}

model OfferRoom {
  id        String @id @default(cuid())
  offerId   String
  roomTypeId String
  offer     Offer    @relation(fields: [offerId], references: [id], onDelete: Cascade)
  roomType  RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)

  @@unique([offerId, roomTypeId])
  @@map("offer_rooms")
}

// ────────────────────────────────────────────────────────────
// CONTENT
// ────────────────────────────────────────────────────────────

model ContentSection {
  id          String   @id @default(cuid())
  key         String   @unique // hero | quick_booking | featured_rooms | why_hotel | offers | services | gallery | location | reviews | contact
  titleAr     String
  titleEn     String
  visible     Boolean  @default(true)
  sortOrder   Int      @default(0)
  configJson  String   // section-specific configuration (JSON)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("content_sections")
}

model Faq {
  id        String  @id @default(cuid())
  questionAr String
  questionEn String
  answerAr  String
  answerEn  String
  category  String  @default("general")
  published Boolean @default(true)
  sortOrder Int     @default(0)

  @@map("faqs")
}

model Policy {
  id        String  @id @default(cuid())
  key       String  @unique // booking | cancellation | payment | checkin | checkout | children | pets
  titleAr   String
  titleEn   String
  bodyAr    String
  bodyEn    String
  published Boolean @default(true)
  sortOrder Int     @default(0)

  @@map("policies")
}

model Review {
  id          String   @id @default(cuid())
  guestId     String
  reservationId String?
  rating      Int      // 1..5
  titleAr     String?
  bodyAr      String
  status      String   @default("pending") // pending | approved | rejected
  approvedById String?
  createdAt   DateTime @default(now())

  guest       Guest     @relation(fields: [guestId], references: [id])
  reservation Reservation? @relation(fields: [reservationId], references: [id])
  approvedBy  User?     @relation("ReviewApprovedBy", fields: [approvedById], references: [id])

  @@map("reviews")
}

// ────────────────────────────────────────────────────────────
// GALLERY (standalone media for the gallery section)
// ────────────────────────────────────────────────────────────

model GalleryItem {
  id         String   @id @default(cuid())
  url        String
  altAr      String?
  altEn      String?
  captionAr  String?
  captionEn  String?
  kind       String   @default("image") // image | video
  published  Boolean  @default(true)
  sortOrder  Int      @default(0)
  createdAt   DateTime @default(now())

  @@map("gallery_items")
}

// ────────────────────────────────────────────────────────────
// COMMUNICATION
// ────────────────────────────────────────────────────────────

model ContactRequest {
  id           String   @id @default(cuid())
  reference    String   @unique
  guestId      String?
  guestName    String
  guestPhone   String
  channel      String   @default("whatsapp") // whatsapp | phone | email | form
  subject      String?
  message      String
  status       String   @default("new") // new | assigned | contacted | waiting_customer | waiting_hotel | confirmed | converted | closed | cancelled
  priority     String   @default("normal")
  ownerId      String?
  bookingRequestId String?
  reservationId String?
  lastActivityAt DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  guest       Guest?     @relation(fields: [guestId], references: [id])
  owner       User?      @relation("ContactRequestOwner", fields: [ownerId], references: [id])
  bookingRequest BookingRequest? @relation(fields: [bookingRequestId], references: [id])
  reservation Reservation? @relation(fields: [reservationId], references: [id])

  @@index([status])
  @@map("contact_requests")
}

// ────────────────────────────────────────────────────────────
// SETTINGS
// ────────────────────────────────────────────────────────────

model HotelSetting {
  id        String  @id @default(cuid())
  key       String  @unique
  value     String
  updatedAt DateTime @updatedAt

  @@map("hotel_settings")
}

model FeatureFlag {
  id       String  @id @default(cuid())
  key      String  @unique
  enabled  Boolean @default(true)
  label    String

  @@map("feature_flags")
}

// ────────────────────────────────────────────────────────────
// AUDIT
// ────────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String   // reservation.confirm | payment.record | room.status_change | content.publish | ...
  entity     String   // reservation | payment | room | content | user | ...
  entityId   String
  oldValue   String?
  newValue   String?
  reason     String?
  createdAt  DateTime @default(now())

  actor      User?    @relation(fields: [actorId], references: [id])

  @@index([entity, entityId])
  @@map("audit_logs")
}

model Notification {
  id         String   @id @default(cuid())
  userId     String?
  titleAr    String
  titleEn    String
  bodyAr     String
  bodyEn     String
  link       String?
  category   String   @default("general")
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([userId, read])
  @@map("notifications")
}
