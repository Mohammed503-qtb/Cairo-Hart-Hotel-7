# ============================================================================
# Cairo Heart Hotel — Production .gitignore
# ============================================================================

# ----------------------------------------------------------------------------
# Secrets & environment (NEVER commit real credentials)
# ----------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
secrets/
 clerkprise.json
google-services.json
GoogleService-Info.plist

# ----------------------------------------------------------------------------
# Node / Next.js / Bun
# ----------------------------------------------------------------------------
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

/coverage

# Next.js build outputs
/.next/
/out/
/build
.next-standalone/
.vercel

# Standalone build
.next/standalone/

# ----------------------------------------------------------------------------
# TypeScript
# ----------------------------------------------------------------------------
*.tsbuildinfo
next-env.d.ts

# ----------------------------------------------------------------------------
# Flutter / Dart / Mobile
# ----------------------------------------------------------------------------
mobile/.dart_tool/
mobile/.flutter-plugins
mobile/.flutter-plugins-dependencies
mobile/.packages
mobile/.pub-cache/
mobile/.pub/
mobile/build/
mobile/.build/
mobile/coverage/
mobile/.symbols
mobile/app.*.symbols
mobile/app.*.map.json
mobile/android/.gradle/
mobile/android/captures/
mobile/android/gradlew
mobile/android/gradlew.bat
mobile/android/local.properties
mobile/android/key.properties
mobile/android/app/debug
mobile/android/app/profile
mobile/android/**/GeneratedPluginRegistrant.*
mobile/ios/Pods/
mobile/ios/.symlinks/
mobile/ios/Flutter/.last_build_id
mobile/ios/Flutter/Flutter.framework
mobile/ios/Flutter/Flutter.podspec
mobile/ios/Flutter/flutter_export_environment.sh
mobile/ios/ServiceDefinitions.json
mobile/ios/Runner/GeneratedPluginRegistrant.*

# Keystore for Android release signing
mobile/android/app/keystore.jks
mobile/android/app/upload-keystore.jks
*.keystore
*.jks

# ----------------------------------------------------------------------------
# Generated Flutter web build artifacts (regenerated by CI / build)
# ----------------------------------------------------------------------------
public/flutter-static/

# ----------------------------------------------------------------------------
# Local databases & uploads
# ----------------------------------------------------------------------------
db/*.db
db/*.db-journal
db/*.sqlite
db/*.sqlite-journal
!db/.gitkeep
prisma/migrations/dev/

# Uploads & tool scratch
/upload/
/download/
/tool-results/
/.zscripts/dev.pid
/.zscripts/*.pid

# ----------------------------------------------------------------------------
# Logs & local scratch
# ----------------------------------------------------------------------------
*.log
dev.log
dev.out.log
server.log
local-*
.claude
.z-ai-config
test
prompt

# ----------------------------------------------------------------------------
# Editor / OS
# ----------------------------------------------------------------------------
.DS_Store
.idea/
*.iml
*.ipr
*.iws
.vscode/
*.swp
*.pyc
.DS_Store?
Thumbs.db

# ----------------------------------------------------------------------------
# Skills (private tooling — not part of shipping product)
# ----------------------------------------------------------------------------
/skills/
